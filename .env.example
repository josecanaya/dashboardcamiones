# Supabase — Truckflow catálogo de patentes
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Servidor local (escritura en truck_plate_registry; bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_secret_key

# Frontend (solo lectura; opcional)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_jwt

# Claves nuevas formato sb_* (opcional si usás publishable en cliente)
SUPABASE_PUBLISHABLE_KEY=

# Truckflow API export
TRUCKFLOW_EXPORT_API_BASE=http://138.36.237.33:8090
TRUCKFLOW_LOCAL_SERVER_PORT=8787

# Agente ETL (dashboard pestaña Agente) — clave completa sk-ant-..., NUNCA el JSON de metadatos
ANTHROPIC_API_KEY=
ORQUESTADOR_MODEL=claude-sonnet-4-6

# DSS Professional — video en vivo (requiere VPN; ver docs/POC_DSS_LIVE.md)
# Usuario dedicado de solo-visualización, nunca el admin.
DSS_HOST=
DSS_PORT=443
DSS_USER=
DSS_PASS=
# Credenciales de las cámaras Dahua (RTSP directo; el DSS V8.007 no expone URL de stream).
# Usuario de solo-visualización creado en las cámaras, no el admin.
CAM_RTSP_USER=usuario_camaras
CAM_RTSP_PASS=clave_camaras
CAM_RTSP_PORT=554
# 0 = stream principal, 1 = sub-stream (recomendado para grillas de 6 cámaras)
CAM_RTSP_SUBTYPE=1

# go2rtc local (binario manual: https://github.com/AlexxIT/go2rtc)
GO2RTC_BASE=http://127.0.0.1:1984
