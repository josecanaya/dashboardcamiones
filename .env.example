# Supabase — Truckflow catálogo de patentes
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Servidor local (escritura en truck_plate_registry; bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_secret_key

# Frontend (solo lectura; opcional)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_jwt

# Claves nuevas formato sb_* (opcional si usás publishable en cliente)
SUPABASE_PUBLISHABLE_KEY=

# Truckflow API export
TRUCKFLOW_EXPORT_API_BASE=http://138.36.237.33:8090
TRUCKFLOW_LOCAL_SERVER_PORT=8787
