{
  "name": "mcp-google-slides",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor MCP remoto (Streamable HTTP) para leer, crear y actualizar Google Slides via APIs oficiales de Google. Aislado del dashboard principal.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mcp-google-slides": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "oauth": "tsx src/scripts/authorize.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "googleapis": "^176.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@eslint/js": "^9.18.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2",
    "vitest": "^4.0.18"
  }
}
