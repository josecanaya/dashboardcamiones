# ============================================================================
# mcp-google-slides — configuración de entorno (EJEMPLO)
# Copiá este archivo a `.env` y completá los valores. NUNCA commitees `.env`.
# ============================================================================

# --- Servidor HTTP ---------------------------------------------------------
# Puerto del servidor MCP (Streamable HTTP) y endpoint de salud.
PORT=8790
# Host de bind. En contenedores/producción usar 0.0.0.0.
HOST=127.0.0.1
# URL pública base del servidor (sin slash final). Debe coincidir con el
# dominio HTTPS donde despliegues. Se usa para construir el callback OAuth.
PUBLIC_BASE_URL=http://127.0.0.1:8790

# --- Autenticación del CLIENTE MCP (separada de OAuth de Google) -----------
# Token bearer que el cliente MCP (Claude/ChatGPT) debe enviar en el header
# `Authorization: Bearer <token>` para poder hablar con /mcp.
# Dejar vacío SOLO en desarrollo local para desactivar la verificación.
MCP_AUTH_TOKEN=

# --- OAuth 2.0 de Google (AUTORIZACIÓN por usuario) ------------------------
# Credenciales del cliente OAuth creado en Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URI de callback. Debe estar registrada EXACTA en la consola de Google.
# Por defecto se deriva de PUBLIC_BASE_URL + /oauth/callback.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8790/oauth/callback
# Scopes de Google (mínimo privilegio). Separados por espacios.
# Default funcional para las 14 tools:
#   presentations   -> leer/crear/editar Slides
#   drive.file      -> gestionar archivos creados/abiertos por la app
#   drive.readonly  -> buscar/duplicar/exportar presentaciones existentes
# Si NO necesitás buscar/duplicar/exportar archivos ajenos, quitá drive.readonly.
GOOGLE_SCOPES=https://www.googleapis.com/auth/presentations https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/drive.readonly

# --- Almacenamiento seguro de refresh tokens -------------------------------
# Backend del token store: "file" (cifrado local) o "supabase".
TOKEN_STORE=file
# Clave de cifrado AES-256-GCM en HEX de 64 chars (32 bytes) o base64.
# Generá una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# Ruta del archivo cifrado cuando TOKEN_STORE=file.
TOKEN_STORE_PATH=./.tokens/tokens.json.enc

# --- Supabase (opcional, solo si TOKEN_STORE=supabase) ---------------------
# Reutilizá el proyecto Supabase existente del dashboard si querés.
SUPABASE_URL=
# Usar la SERVICE ROLE key (server-side). NUNCA exponerla al cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Nombre de tabla donde se guardan los tokens cifrados.
SUPABASE_TOKENS_TABLE=mcp_google_oauth_tokens

# --- Identidad de usuario por defecto --------------------------------------
# Este servidor está pensado para un tenant/usuario operativo. Todas las
# operaciones usan este userId salvo que la tool reciba otro explícito.
DEFAULT_USER_ID=default

# --- Resiliencia de red hacia las APIs de Google ---------------------------
# Timeout por request a Google (ms).
GOOGLE_HTTP_TIMEOUT_MS=30000
# Reintentos con backoff exponencial ante errores transitorios (429/5xx).
GOOGLE_MAX_RETRIES=3

# --- Logging ---------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
