{
  "name": "truck-route-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server:truckflow": "node server/truckflow-local-server.mjs",
    "db:migrate:plate-registry": "node scripts/apply-plate-registry-migration.mjs",
    "db:migrate:etl-runs": "node scripts/apply-etl-runs-migration.mjs",
    "db:sync:plate-registry": "node scripts/sync-plate-registry-to-supabase.mjs",
    "etl:upload": "node scripts/upload-etl-run.mjs",
    "dev:committee": "concurrently -k \"npm run server:truckflow\" \"npm run dev\"",
    "dev:live": "pnpm run seed:live && pnpm run dev",
    "seed:live": "cd simulador && npm run simulate -- --scenario=live --reset && npm run simulate -- --scenario=live",
    "seed:march_full": "node simulador/scripts/seed-march-full.cjs",
    "diversify:march_full": "node simulador/scripts/diversify-march-durations.cjs",
    "simulator:live": "cd simulador && npm run simulate:start -- --scenario=live --intervalSec=3",
    "simulator:live:fg": "cd simulador && npm run simulate:foreground -- --scenario=live --intervalSec=3",
    "simulator:live:turbo": "cd simulador && npm run simulate:foreground -- --scenario=live --intervalSec=0.12",
    "simulator:reset:turbo": "cd simulador && npx tsx src/index.ts --scenario=live --reset && npm run simulate:foreground -- --scenario=live --intervalSec=0.12",
    "simulator:reset:live": "cd simulador && npx tsx src/index.ts --scenario=live --reset && npm run simulate:foreground -- --scenario=live --intervalSec=5",
    "simulator:stop": "cd simulador && npm run simulate:stop",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node scripts/check-arch-rules.mjs && vitest run",
    "check:arch": "node scripts/check-arch-rules.mjs",
    "etl:run": "npx tsx scripts/run-etl-headless.ts",
    "smoke:etl": "node scripts/smoke-etl-api.mjs",
    "test:watch": "vitest",
    "contract-first:local": "node scripts/run-truckflow-transform-local.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "framer-motion": "^11.11.17",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "recharts": "^3.7.0",
    "three": "^0.183.2",
    "web-ifc": "^0.0.77",
    "web-ifc-three": "^0.0.126",
    "xlsx": "^0.18.5",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.2",
    "vite": "^5.4.10",
    "vitest": "^4.0.18"
  }
}
